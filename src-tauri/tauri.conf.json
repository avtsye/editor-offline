{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editor Offline",
  "version": "0.1.0",
  "identifier": "il.avtsye.editoroffline",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Editor Offline",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Offline-first code editor",
    "longDescription": "A lightweight, independent code editor designed to work locally on Windows.",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
