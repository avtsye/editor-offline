{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editor Offline",
  "version": "0.1.0",
  "identifier": "il.avtsye.editoroffline",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "עורך קוד אופליין",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "עורך קוד מקצועי, עצמאי וללא חיבור לרשת",
    "longDescription": "סביבת פיתוח מקומית למערכת Windows, עם ממשק עברי, עריכת קוד, ניהול פרויקטים וכלי פיתוח — ללא תלות בחיבור לאינטרנט.",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "Hebrew",
          "English"
        ]
      }
    }
  }
}
